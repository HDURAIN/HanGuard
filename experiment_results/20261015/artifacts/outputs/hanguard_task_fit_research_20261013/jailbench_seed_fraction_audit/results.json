  "methods": {
    "tokenizer": "tokenizers.Tokenizer.from_file; add_special_tokens=False; no truncation",
    "primary_fraction": "standalone parent seed token count / complete query token count",
    "literal_coverage": "complete-query token offsets intersecting any nonoverlapping exact parent seed occurrence / complete-query token count",
    "parent_mapping": "source_row // 20; validated exact query equality in B and exact seed occurrences in all 10800 source queries",
    "bins": "lower exclusive, upper inclusive; no bin selected from observed error outcomes",
    "hard_prediction": "saved OOF probability >= saved per-fold inner-dev threshold; no recalibration",
    "evaluation_scope": "unseen_parent_seed_seen_wrapper_families; not an unseen-wrapper evaluation"
  },
  "limitations": [
    "Parent seed is not a gold harmful span; wrapper text may add harmful intent or benign context.",
    "Primary fraction counts one seed encoding even when the seed is repeated; literal coverage is reported separately.",
    "Standalone and in-query subword boundaries can differ; token-offset coverage includes boundary tokens.",
    "Only exact literal seed occurrences are measured; neither metric identifies all semantic evidence.",
    "JailBench has only harmful source labels; recall cannot establish safe-versus-harmful discrimination or FPR.",
    "Primary split leaves wrapper families seen; template/source shortcuts remain possible.",
    "These descriptive bins do not establish a causal relation between sparse evidence and model errors.",
    "This train-internal B audit does not evaluate the formal validation/test sets or generalize signal ratios to WildGuard."
  ],
