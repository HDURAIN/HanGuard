# Local environments, credentials and tooling caches
.venv*/
.env
.env.*
*.token
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
start_claude.sh

# Model weights and reproducible training outputs stay local.
models/
checkpoints/
outputs/*
!outputs/.gitkeep
*.safetensors
*.bin
*.pt
*.pth

# Keep current dataset cards, manifests and audits in Git, not text corpora.
data/sources/*
!data/sources/reference/
data/**/*.parquet
data/**/*.csv
data/**/*.jsonl
data/**/*.txt
data/**/*.npy
data/**/*.npz
data/**/*.xlsx
data/**/*.docx
!data/sources/reference/*.xlsx
!data/sources/reference/*.docx

# Historical source/metadata archives remain local; the archive index is tracked.
archive/*.tar.gz
archive/source_provenance/
legacy/
